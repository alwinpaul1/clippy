<?xml version="1.0" encoding="utf-8"?>
<!-- Event types: the copy triggers only. typeNotificationStateChanged is the
     Samsung "Copied to clipboard." toast; typeAnnouncement and
     typeWindowStateChanged are how Pixel's (Android 13+) SystemUI clipboard
     overlay shows up — it posts NO toast, so without these the service never
     hears about a copy on stock Android.

     No packageNames filter (it used to narrow delivery to
     com.android.systemui). The copy triggers are still gated to systemui IN
     CODE; window changes from every other app are needed for one thing only:
     when no read could get focus (a screen that hides overlays AND blocked the
     read activity), the owed read is retried on the next switch to another
     app. Every non-systemui event costs one string compare. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeNotificationStateChanged|typeAnnouncement|typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canRetrieveWindowContent="false"
    android:description="@string/a11y_desc"
    android:notificationTimeout="100" />
